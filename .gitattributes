# Force LF line endings for shell scripts and Dockerfiles
# Windows users with core.autocrlf=true would otherwise get CRLF,
# which breaks shell scripts inside Linux containers.
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerignore text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.md text eol=lf
