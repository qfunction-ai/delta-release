# Delta Configuration
# ===================
# Secrets are auto-generated on first run if not set.
# Only set these if you want to override the auto-generated values.

# JWT secret for authentication
# Auto-generated on first run if not set.
# JWT_SECRET=

# Encryption key for provider credentials (Fernet key or arbitrary string)
# Auto-generated on first run if not set. If you provide your own,
# use: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIALS_ENCRYPTION_KEY=

# Postgres password (default: delta)
# POSTGRES_PASSWORD=delta

# Service token for inter-service auth (backend → eval, backend → pip-sidecar)
# Auto-generated on first run if not set.
# SERVICE_TOKEN=

# LLM Provider API keys — configured in Letta's own settings, not passed through compose.
# At least one is required for Letta to function. Set these in the Letta container
# environment or via the Letta admin UI, not in this file.
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# CORS origins (comma-separated — default: http://localhost:3000,http://127.0.0.1:3000)
# NEVER use * in production with credentials enabled
# DELTA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Setup token (required in production — prevents unauthenticated admin creation)
# DELTA_SETUP_TOKEN=your-setup-token-here

# Exa API key for agent web search (optional — enables web_search tool for agents)
# EXA_API_KEY=your-exa-api-key-here

# Dev mode (relaxes security defaults for local development — NEVER use in production)
# DELTA_DEV_MODE=1

# Rate limit override (dev mode only — e.g., 1000/minute for testing)
# DELTA_RATE_LIMIT_DEFAULT=1000/minute
